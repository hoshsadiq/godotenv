{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly",
    ":prImmediately",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "go modules (all)",
      "groupSlug": "gomod"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions (all)",
      "groupSlug": "gha",
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools (all)",
      "groupSlug": "mise"
    },
    {
      "matchDatasources": ["golang-version"],
      "matchPackageNames": ["go"],
      "groupName": "go minimum version",
      "minimumReleaseAge": "540 days",
      "rangeStrategy": "replace"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang", "alpine", "debian", "ubuntu", "distroless"],
      "groupName": "base images"
    },
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "all patch updates",
      "groupSlug": "patch",
      "automerge": true,
      "matchPackageNames": ["*"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "renovate"]
  },
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.mod$/"],
      "matchStrings": ["^go (?<currentValue>\\d+\\.\\d+)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "npm",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    }
  ]
}
